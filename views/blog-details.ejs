                                                    src="../<%= blog.image %>"
                                                    class="img-responsive wp-post-image" alt="" decoding="async" /> </a>

                                            <div class="post_category">
                                                <a class="category"
                                                    href="#"><%= blog.category %></a>
                                            </div>
                                        </div>

                                        <div class="tj-post__content">
                                            <!-- entry-meta -->
                                            <div class="tj-post__meta entry-meta blog-meta">
                                                <span><i class="fa fa-users"></i>

                                                    <span><a
                                                            href='#'><%= blog.blogAuthor %></a></span> </span>

                                                <span><i class="fa fa-calendar"></i><%= new Date(blog.createdDateTime).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></span>

                                                <% if (blog.comments.length === 0) { %>
                                                    <span><i class="fa fa-comments-o"></i><a href="#">No Comments</a></span>
                                                <% } else if (blog.comments.length === 1) { %>
                                                    <span><i class="fa fa-comments-o"></i><a href="#">1 Comment</a></span>
                                                <% } else { %>
                                                    <span><i class="fa fa-comments-o"></i><a href="#"><%= blog.comments.length %> Comments</a></span>
                                                <% } %>
                                            </div>
                                            <!-- entry content -->
                                            <div class="tj-entry__content">

                                                <p><%= blog.mainDescription %></p>
                                                <h3 class="title"><%= blog.subTitle %></h3>
                                                <p><%= blog.subDescription %></p>
                                                <blockquote>
                                                    <p>‘’ <%= blog.quotes %>’’</p>
                                                    <p><cite><%= blog.quotesAuthor %></cite></p>
                                                </blockquote>
                                                <div class="row video-box">
                                                    <div class="col-lg-6">
