                        <div class="row">
                            <div class="col-lg-8">
                                <!-- post details container -->
                                <div class="tj-post-details__container tj-post-wrapper">

                                    <!-- single post -->
                                    <article id="post-774"
                                        class="tj-single__post post-774 post type-post status-publish format-image has-post-thumbnail hentry category-analytics category-consulting tag-analytics tag-consulting tag-support tag-unique-technologies post_format-post-format-image">

                                        <!-- post thumbnail -->
